 // convertModelToMap converts ModelInfo to the appropriate format for different handler types
+// PrefixedDisplayName labels prefixed copies of a model ("work/x" -> "X (work)")
+// for pickers that list display names only.
+func PrefixedDisplayName(info *ModelInfo) string {
+	name := info.DisplayName
+	if name == "" {
+		name = info.ID
+	}
+	if prefix, _, ok := strings.Cut(info.ID, "/"); ok {
+		return name + " (" + prefix + ")"
+	}
+	return name
+}
+
+// OutputsText reports whether a model produces text. Models without declared
+// output modalities are chat models.
+func OutputsText(info *ModelInfo) bool {
+	if len(info.SupportedOutputModalities) == 0 {
+		return true
+	}
+	for _, modality := range info.SupportedOutputModalities {
+		if strings.EqualFold(modality, "text") {
+			return true
+		}
+	}
+	return false
+}
