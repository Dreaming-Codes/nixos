+// registryInfoOutputsText keeps image, video and audio generators out of the
+// Grok Shell picker. Models without declared output modalities are chat models.
+func registryInfoOutputsText(info *registry.ModelInfo) bool {
+	if len(info.SupportedOutputModalities) == 0 {
+		return true
+	}
+	for _, modality := range info.SupportedOutputModalities {
+		if strings.EqualFold(modality, "text") {
+			return true
+		}
+	}
+	return false
+}
