+#pragma once
+
+#include <fcntl.h>
+#include <linux/videodev2.h>
+#include <poll.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace icamera {
+
+/**
+ * The short exposure of a staggered-HDR sensor, captured from its own ISYS node.
+ *
+ * The sensor ends the short frame of an exposure pair a fixed number of rows
+ * after the long one, less than half a frame period, so frames pair by timestamp.
+ */
+class ShortExposureSource {
+ public:
+    ~ShortExposureSource() { stop(); }
+
+    bool isStarted() const { return mFd >= 0; }
+
+    int start(const char* devName, uint32_t width, uint32_t height, uint32_t pixelFormat) {
+        stop();
+
+        mFd = open(devName, O_RDWR | O_NONBLOCK);
+        if (mFd < 0) return -1;
+
+        struct v4l2_format fmt = {};
+        fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        fmt.fmt.pix.width = width;
+        fmt.fmt.pix.height = height;
+        fmt.fmt.pix.pixelformat = pixelFormat;
+        fmt.fmt.pix.field = V4L2_FIELD_NONE;
+
+        struct v4l2_requestbuffers req = {};
+        req.count = kBufferCount;
+        req.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        req.memory = V4L2_MEMORY_MMAP;
+
+        if ((ioctl(mFd, VIDIOC_S_FMT, &fmt) != 0) || (ioctl(mFd, VIDIOC_REQBUFS, &req) != 0)) {
+            stop();
+            return -1;
+        }
+
+        for (uint32_t i = 0U; i < req.count; i++) {
+            struct v4l2_buffer buf = {};
+            buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+            buf.memory = V4L2_MEMORY_MMAP;
+            buf.index = i;
+            if (ioctl(mFd, VIDIOC_QUERYBUF, &buf) != 0) break;
+
+            void* addr = mmap(nullptr, buf.length, PROT_READ, MAP_SHARED, mFd, buf.m.offset);
+            if (addr == MAP_FAILED) break;
+            mBuffers.push_back({addr, buf.length});
+
+            if (ioctl(mFd, VIDIOC_QBUF, &buf) != 0) break;
+        }
+
+        int type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        if ((mBuffers.size() != req.count) || (ioctl(mFd, VIDIOC_STREAMON, &type) != 0)) {
+            stop();
+            return -1;
+        }
+
+        mRun = true;
+        mThread = std::thread(&ShortExposureSource::captureLoop, this);
+        return 0;
+    }
+
+    void stop() {
+        if (mThread.joinable()) {
+            mRun = false;
+            mThread.join();
+        }
+        if (mFd >= 0) {
+            int type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+            (void)ioctl(mFd, VIDIOC_STREAMOFF, &type);
+        }
+        for (auto& buf : mBuffers) {
+            (void)munmap(buf.addr, buf.length);
+        }
+        mBuffers.clear();
+        mReady.clear();
+        if (mFd >= 0) {
+            (void)close(mFd);
+            mFd = -1;
+        }
+    }
+
+    /**
+     * Copy the short frame that pairs with the long frame stamped longTime.
+     * Returns false when the sensor or ISYS dropped it; dst is left alone.
+     */
+    bool copyFrame(const struct timeval& longTime, void* dst, size_t size) {
+        const int64_t longUs = toUs(longTime);
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(50);
+
+        std::unique_lock<std::mutex> lock(mLock);
+        while (true) {
+            while (!mReady.empty() && (mReady.front().us < longUs - kEarlyUs)) {
+                queueBuffer(mReady.front().index);
+                mReady.pop_front();
+            }
+            if (!mReady.empty()) break;
+            if (mArrived.wait_until(lock, deadline) == std::cv_status::timeout) return false;
+        }
+
+        const Frame frame = mReady.front();
+        if (frame.us - longUs > mPeriodUs / 2) return false;
+
+        mReady.pop_front();
+        (void)memcpy(dst, mBuffers[frame.index].addr, std::min(size, frame.bytes));
+        flushCache(dst, std::min(size, frame.bytes));
+        queueBuffer(frame.index);
+        return true;
+    }
+
+    // PSYS does not snoop the CPU caches, and the driver skips its flush for the
+    // HAL's own buffers, which it takes to be written by hardware only.
+    static void flushCache(void* addr, size_t size) {
+        char* p = static_cast<char*>(addr);
+        for (size_t i = 0U; i < size; i += 64U) {
+            __builtin_ia32_clflush(p + i);
+        }
+        __builtin_ia32_mfence();
+    }
+
+ private:
+    struct Buffer {
+        void* addr;
+        size_t length;
+    };
+    struct Frame {
+        uint32_t index;
+        int64_t us;
+        size_t bytes;
+    };
+
+    static int64_t toUs(const struct timeval& t) {
+        return static_cast<int64_t>(t.tv_sec) * 1000000 + t.tv_usec;
+    }
+
+    void queueBuffer(uint32_t index) {
+        struct v4l2_buffer buf = {};
+        buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        buf.memory = V4L2_MEMORY_MMAP;
+        buf.index = index;
+        (void)ioctl(mFd, VIDIOC_QBUF, &buf);
+    }
+
+    void captureLoop() {
+        int64_t lastUs = 0;
+
+        while (mRun) {
+            struct pollfd pfd = {mFd, POLLIN, 0};
+            if (poll(&pfd, 1, 100) <= 0) continue;
+
+            struct v4l2_buffer buf = {};
+            buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+            buf.memory = V4L2_MEMORY_MMAP;
+            if (ioctl(mFd, VIDIOC_DQBUF, &buf) != 0) continue;
+
+            std::lock_guard<std::mutex> lock(mLock);
+            // ISYS flags a frame the sensor cut short while it moved the short window.
+            if ((buf.flags & V4L2_BUF_FLAG_ERROR) != 0U) {
+                queueBuffer(buf.index);
+                continue;
+            }
+
+            const int64_t us = toUs(buf.timestamp);
+            if (lastUs != 0) mPeriodUs = us - lastUs;
+            lastUs = us;
+
+            mReady.push_back({buf.index, us, buf.bytesused});
+            // ISYS needs free buffers to keep capturing.
+            if (mReady.size() > kHeldFrames) {
+                queueBuffer(mReady.front().index);
+                mReady.pop_front();
+            }
+            mArrived.notify_all();
+        }
+    }
+
+    static const uint32_t kBufferCount = 8U;
+    static const size_t kHeldFrames = 4U;
+    // Timestamps of one exposure pair never run backwards by more than jitter.
+    static const int64_t kEarlyUs = 1000;
+
+    int mFd = -1;
+    std::vector<Buffer> mBuffers;
+    std::deque<Frame> mReady;
+    int64_t mPeriodUs = 33333;
+    std::mutex mLock;
+    std::condition_variable mArrived;
+    std::thread mThread;
+    std::atomic<bool> mRun{false};
+};
+
+}  // namespace icamera
