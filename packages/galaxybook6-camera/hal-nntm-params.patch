+// The parameter kernel of a software node has no terminals: its output exists only in the
+// group's PAL output, which runAIC returns.
+status_t IpuPacAdaptor::configNntm(int streamId, uint8_t groupId, aic::ImagingKernelGroup* kernels) {
+    cca::cca_aic_config aicConfig{};
+    aicConfig.cb_num = 1;
+    aicConfig.cb_config[0].group_id = groupId;
+    aicConfig.cb_config[0].fragment_count = 0;
+    aicConfig.cb_config[0].kernel_group = kernels;
+    cca::cca_aic_kernel_offset offset{};
+    offset.cb_num = 1;
+    offset.cb_kernel_offset[0].group_id = groupId;
+    cca::cca_aic_terminal_config termConfig{};
+    termConfig.cb_num = 1;
+    termConfig.cb_terminal_buf[0].group_id = groupId;
+    const uint32_t graphMode = kernels->operationMode;
+    kernels->operationMode = 0;
+    const status_t ret = pacConfig(streamId, aicConfig, offset, nullptr, &termConfig,
+                                   CBLayoutUtils::getStatsBufToTermIds());
+    kernels->operationMode = graphMode;
+    if (ret == OK) {
+        AutoMutex l(mPacAdaptorLock);
+        mNntmGroup[streamId] = groupId;
+        const ia_isp_bxt_resolution_info_t* history = kernels->kernelList[0].run_kernel.resolution_history;
+        if (history != nullptr) {
+            mNntmHistory[streamId] = *history;
+        }
+    }
+    return ret;
+}
+
+// The kernel takes faces in pixels of the sensor frame and maps them through its own resolution
+// history; a face left of or above that history's crop fails the kernel run.
+void IpuPacAdaptor::setNntmFaces(int streamId, cca::cca_pal_input_params* params) {
+    params->face_roi.num_faces = 0;
+    params->face_roi.faces = mNntmFaces;
+    const auto history = mNntmHistory.find(streamId);
+    const FaceDetectionResult* result = mAiqResultStorage->getFaceResult();
+    if ((history == mNntmHistory.end()) || (result == nullptr)) {
+        return;
+    }
+    const ia_isp_bxt_resolution_info_t& h = history->second;
+    const camera_coordinate_system_t ia = {IA_COORDINATE_LEFT, IA_COORDINATE_TOP,
+                                           IA_COORDINATE_RIGHT, IA_COORDINATE_BOTTOM};
+    const camera_coordinate_system_t sensor = {h.input_crop.left, h.input_crop.top,
+                                               h.input_width - h.input_crop.right,
+                                               h.input_height - h.input_crop.bottom};
+    const uint32_t count = std::min<uint32_t>(result->ccaFaceState.num_faces, cca::MAX_FACE_NUM);
+    for (uint32_t i = 0U; i < count; i++) {
+        const ia_rectangle& area = result->ccaFaceState.faces[i].face_area;
+        const camera_coordinate_t lt =
+            AiqUtils::convertCoordinateSystem(ia, sensor, {area.left, area.top});
+        const camera_coordinate_t rb =
+            AiqUtils::convertCoordinateSystem(ia, sensor, {area.right, area.bottom});
+        ia_face_roi& roi = mNntmFaces[i];
+        CLEAR(roi);
+        roi.face_area = {lt.x, lt.y, rb.x, rb.y};
+        roi.tracking_id = result->ccaFaceState.faces[i].tracking_id;
+    }
+    params->face_roi.num_faces = count;
+}
