+void PipeLine::configureNntmParams(int32_t numLinks, GraphLink** links) {
+    static constexpr uint32_t kNntmKernelUuid = 46539U;
+    for (int32_t i = 0; i < numLinks; i++) {
+        OuterNode* node = links[i]->destNode;
+        if (node == nullptr || node->type != NodeTypes::Sw || node->nodeKernels.kernelCount != 1U ||
+            node->nodeKernels.kernelList[0].run_kernel.kernel_uuid != kNntmKernelUuid) {
+            continue;
+        }
+        const status_t ret = mPacAdaptor->configNntm(mStreamId, node->contextId, &node->nodeKernels);
+        if (ret != OK) {
+            LOGW("%s: tone-mapping parameter kernel not configured, ret %d", __func__, ret);
+        }
+        return;
+    }
+}
