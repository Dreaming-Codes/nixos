+void AiqResultStorage::storeNntmParams(int64_t sequence, const void* data, size_t size) {
+    std::lock_guard<std::mutex> l(mNntmLock);
+    NntmParams& slot = mNntmParams[static_cast<size_t>(sequence) % kStorageSize];
+    slot.sequence = sequence;
+    slot.data.assign(static_cast<const uint8_t*>(data), static_cast<const uint8_t*>(data) + size);
+}
+
+int AiqResultStorage::copyNntmParams(int64_t sequence, void* data, size_t size) {
+    std::lock_guard<std::mutex> l(mNntmLock);
+    const NntmParams& slot = mNntmParams[static_cast<size_t>(sequence) % kStorageSize];
+    if ((sequence < 0) || (slot.sequence != sequence)) {
+        return NAME_NOT_FOUND;
+    }
+    if (data == nullptr) {
+        return static_cast<int>(slot.data.size());
+    }
+    CheckAndLogError(size < slot.data.size(), BAD_VALUE, "%s: %zu bytes needed, %zu given", __func__,
+                     slot.data.size(), size);
+    MEMCPY_S(data, size, slot.data.data(), slot.data.size());
+    return static_cast<int>(slot.data.size());
+}
+
 } //namespace icamera
 
