+#define LOG_TAG FaceDetection
+#include "src/fd/FaceCenterNet.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "AiqResultStorage.h"
+#include "CameraContext.h"
+#include "PlatformData.h"
+#include "iutils/CameraLog.h"
+#include "iutils/Utils.h"
+
+namespace icamera {
+
+namespace {
+
+constexpr int kInput = 256;
+constexpr int kStride = 4;
+constexpr int kGrid = kInput / kStride;
+constexpr float kMinScore = 0.6f;
+constexpr double kGamma = 0.6;
+constexpr float kMinSide = 0.05f;
+constexpr float kMinIou = 0.3f;
+constexpr int kLostRuns = 3;
+
+uint8_t clip(float v) {
+    return static_cast<uint8_t>(std::clamp(std::lround(v), 0L, 255L));
+}
+
+}  // namespace
+
+FaceCenterNet::FaceCenterNet(int cameraId, int width, int height)
+        : FaceDetection(cameraId, width, height) {
+    mScale = static_cast<float>(kInput) / std::max(width, height);
+    mInWidth = std::lround(width * mScale);
+    mInHeight = std::lround(height * mScale);
+    mLeft = (kInput - mInWidth) / 2;
+    mTop = (kInput - mInHeight) / 2;
+    for (int i = 0; i < 256; i++) {
+        mGamma[i] = clip(255.0 * std::pow(i / 255.0, kGamma));
+    }
+
+    const std::string dir = PlatformData::getCameraCfgPath();
+    try {
+        ov::Core core;
+        auto model = core.compile_model(dir + "centernet_face.xml", "CPU",
+                                        ov::inference_num_threads(1),
+                                        ov::hint::performance_mode(ov::hint::PerformanceMode::LATENCY));
+        auto output = [&model](const char* head) {
+            for (size_t i = 0; i < model.outputs().size(); i++) {
+                if (model.outputs()[i].get_any_name().find(head) != std::string::npos) return i;
+            }
+            throw std::runtime_error(std::string("no output ") + head);
+        };
+        mHeatmap = output("HeatMapHead");
+        mOffset = output("OffsetHead");
+        mSize = output("DimensionHead");
+        mRequest = model.create_infer_request();
+    } catch (const std::exception& e) {
+        LOGE("<id%d> face model in %s not loaded: %s", cameraId, dir.c_str(), e.what());
+        return;
+    }
+    uint8_t* in = mRequest.get_input_tensor().data<uint8_t>();
+    std::fill(in, in + kInput * kInput * 4, 127);
+    mInitialized = true;
+}
+
+void FaceCenterNet::runFaceDetection(const std::shared_ptr<CameraBuffer>& camBuffer) {
+    CameraBufferMapper mapper(camBuffer);
+    const auto* y = static_cast<const uint8_t*>(mapper.addr());
+    CheckAndLogError(!y || camBuffer->getFormat() != V4L2_PIX_FMT_NV12, VOID_VALUE,
+                     "@%s, need a mapped NV12 buffer", __func__);
+    const int stride = camBuffer->getStride();
+    const nsecs_t start = CameraUtils::systemTime();
+    fillInput(y, y + stride * mHeight, stride);
+    mRequest.infer();
+    publish(track(decode()), camBuffer->getSequence());
+    LOG2("<seq%u> face detection took %ld us", camBuffer->getSequence(),
+         static_cast<long>((CameraUtils::systemTime() - start) / 1000));
+}
+
+void FaceCenterNet::fillInput(const uint8_t* y, const uint8_t* uv, int stride) {
+    uint8_t* in = mRequest.get_input_tensor().data<uint8_t>();
+    for (int j = 0; j < mInHeight; j++) {
+        const int y0 = j * mHeight / mInHeight, y1 = (j + 1) * mHeight / mInHeight;
+        uint8_t* px = in + ((mTop + j) * kInput + mLeft) * 4;
+        for (int i = 0; i < mInWidth; i++, px += 4) {
+            const int x0 = i * mWidth / mInWidth, x1 = (i + 1) * mWidth / mInWidth;
+            int sy = 0, su = 0, sv = 0, n = 0, m = 0;
+            for (int r = y0; r < y1; r += 2) {
+                for (int c = x0; c < x1; c += 2, n++) sy += y[r * stride + c];
+                const uint8_t* chroma = uv + r / 2 * stride;
+                for (int c = x0 & ~1; c < x1; c += 2, m++) {
+                    su += chroma[c];
+                    sv += chroma[c + 1];
+                }
+            }
+            const float l = 1.164f * (static_cast<float>(sy) / n - 16.f);
+            const float u = static_cast<float>(su) / m - 128.f;
+            const float v = static_cast<float>(sv) / m - 128.f;
+            px[0] = mGamma[clip(l + 1.596f * v)];
+            px[1] = mGamma[clip(l - 0.392f * u - 0.813f * v)];
+            px[2] = mGamma[clip(l + 2.017f * u)];
+        }
+    }
+}
+
+std::vector<FaceCenterNet::Face> FaceCenterNet::decode() {
+    const float* heat = mRequest.get_output_tensor(mHeatmap).data<float>();
+    const float* offset = mRequest.get_output_tensor(mOffset).data<float>();
+    const float* size = mRequest.get_output_tensor(mSize).data<float>();
+    constexpr int kPlane = kGrid * kGrid;
+    std::vector<Face> faces;
+    for (int gy = 0; gy < kGrid; gy++) {
+        for (int gx = 0; gx < kGrid; gx++) {
+            const int i = gy * kGrid + gx;
+            const float score = heat[i];
+            if (score < kMinScore) continue;
+            bool peak = true;
+            for (int ny = std::max(gy - 1, 0); ny <= std::min(gy + 1, kGrid - 1); ny++) {
+                for (int nx = std::max(gx - 1, 0); nx <= std::min(gx + 1, kGrid - 1); nx++) {
+                    peak = peak && heat[ny * kGrid + nx] <= score;
+                }
+            }
+            if (!peak) continue;
+            // The size head is the log of half the box size as a fraction of the input.
+            const float cy = ((gy + offset[i]) * kStride - mTop) / mScale;
+            const float cx = ((gx + offset[kPlane + i]) * kStride - mLeft) / mScale;
+            const float h = std::exp(size[i]) * kInput / mScale;
+            const float w = std::exp(size[kPlane + i]) * kInput / mScale;
+            if (2 * std::max(w, h) < kMinSide * std::max(mWidth, mHeight)) continue;
+            faces.push_back({score, std::max(cx - w, 0.f), std::max(cy - h, 0.f),
+                             std::min(cx + w, static_cast<float>(mWidth)),
+                             std::min(cy + h, static_cast<float>(mHeight)), -1});
+        }
+    }
+    return faces;
+}
+
+std::vector<FaceCenterNet::Face> FaceCenterNet::track(std::vector<Face> faces) {
+    const auto area = [](const Face& f) { return (f.right - f.left) * (f.bottom - f.top); };
+    const auto iou = [&area](const Face& a, const Face& b) {
+        const float w = std::min(a.right, b.right) - std::max(a.left, b.left);
+        const float h = std::min(a.bottom, b.bottom) - std::max(a.top, b.top);
+        const float common = std::max(w, 0.f) * std::max(h, 0.f);
+        return common / (area(a) + area(b) - common);
+    };
+    std::vector<bool> matched(mTracks.size());
+    std::vector<Track> next;
+    for (Face& f : faces) {
+        int best = -1;
+        float bestIou = kMinIou;
+        for (size_t i = 0; i < mTracks.size(); i++) {
+            const float o = iou(f, mTracks[i].face);
+            if (!matched[i] && o >= bestIou) {
+                best = i;
+                bestIou = o;
+            }
+        }
+        if (best >= 0) matched[best] = true;
+        f.id = best >= 0 ? mTracks[best].face.id : mNextId++;
+        next.push_back({f, 0});
+    }
+    for (size_t i = 0; i < mTracks.size(); i++) {
+        if (!matched[i] && mTracks[i].lost < kLostRuns) next.push_back({mTracks[i].face, mTracks[i].lost + 1});
+    }
+    mTracks = next;
+
+    std::vector<Face> out;
+    for (const Track& t : mTracks) out.push_back(t.face);
+    std::sort(out.begin(), out.end(), [&area](const Face& a, const Face& b) { return area(a) > area(b); });
+    if (out.size() > mMaxFaceNum) out.resize(mMaxFaceNum);
+    return out;
+}
+
+void FaceCenterNet::publish(const std::vector<Face>& faces, int64_t sequence) {
+    camera_coordinate_system_t iaCoord = {IA_COORDINATE_LEFT, IA_COORDINATE_TOP,
+                                          IA_COORDINATE_RIGHT, IA_COORDINATE_BOTTOM};
+    auto storage = CameraContext::getInstance(mCameraId)->getAiqResultStorage();
+    FaceDetectionResult* result = storage->acquireFaceResult();
+    CLEAR(*result);
+    result->ccaFaceState.num_faces = faces.size();
+    result->ccaFaceState.updated = true;
+    result->ccaFaceState.is_video_conf = true;
+    result->ccaFaceState.fd_algo = CENTERNET_FD;
+    for (size_t i = 0; i < faces.size(); i++) {
+        const Face& f = faces[i];
+        ia_atbx_face& face = result->ccaFaceState.faces[i];
+        face.face_area = {static_cast<int>(f.left), static_cast<int>(f.top),
+                          static_cast<int>(f.right), static_cast<int>(f.bottom)};
+        LOG2("<seq%ld> face %zu id %d score %.2f box %d,%d,%d,%d", sequence, i, f.id, f.score,
+             face.face_area.left, face.face_area.top, face.face_area.right, face.face_area.bottom);
+        convertFaceCoordinate(iaCoord, &face.face_area.left, &face.face_area.top,
+                              &face.face_area.right, &face.face_area.bottom);
+        face.tracking_id = f.id;
+        face.confidence = std::lround(f.score * 100);
+        face.person_id = -1;
+    }
+    {
+        AutoMutex l(mFaceResultLock);
+        mLastFaceNum = faces.size();
+    }
+    storage->updateFaceResult(sequence);
+}
+
+}  // namespace icamera
