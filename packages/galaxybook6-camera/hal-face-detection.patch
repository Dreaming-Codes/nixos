+#pragma once
+
+#include <openvino/openvino.hpp>
+
+#include <vector>
+
+#include "FaceDetection.h"
+
+namespace icamera {
+
+class FaceCenterNet : public FaceDetection {
+ public:
+    FaceCenterNet(int cameraId, int width, int height);
+    void runFaceDetection(const std::shared_ptr<CameraBuffer>& camBuffer) override;
+
+ private:
+    struct Face {
+        float score;
+        float left, top, right, bottom;
+        int id;
+    };
+    struct Track {
+        Face face;
+        int lost;
+    };
+
+    void fillInput(const uint8_t* y, const uint8_t* uv, int stride);
+    std::vector<Face> decode();
+    std::vector<Face> track(std::vector<Face> faces);
+    void publish(const std::vector<Face>& faces, int64_t sequence);
+
+    ov::InferRequest mRequest;
+    size_t mHeatmap, mOffset, mSize;
+    uint8_t mGamma[256];
+    float mScale;
+    int mLeft, mTop, mInWidth, mInHeight;
+    std::vector<Track> mTracks;
+    int mNextId = 0;
+};
+
+}  // namespace icamera
