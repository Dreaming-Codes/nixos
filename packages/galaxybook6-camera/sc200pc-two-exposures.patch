+static int sc200pc_write_short_window(struct sc200pc *sensor, u16 window,
+				      bool late)
+{
+	u8 rows[] = { window >> 8, window };
+	int ret;
+
+	if (window == sensor->short_window)
+		return 0;
+
+	ret = sc200pc_write_reg(sensor, SC200PC_REG_GROUP_LATCH, late);
+	if (!ret)
+		ret = sc200pc_write_reg(sensor, SC200PC_REG_GROUP_HOLD, 0x00);
+	if (!ret)
+		ret = sc200pc_write_regs(sensor, SC200PC_REG_SHORT_WINDOW_H,
+					 rows, sizeof(rows));
+	if (!ret)
+		ret = sc200pc_write_reg(sensor, SC200PC_REG_GROUP_HOLD, 0x30);
+	if (!ret)
+		sensor->short_window = window;
+
+	return ret;
+}
