+/*
+ * This kernel leaves the streams uAPI off, so user space cannot route the
+ * second stream through the CSI-2 receiver; the sensor does it on its behalf.
+ * Called with the control handler locked, and the receiver reads this
+ * sensor's link frequency with its own state locked, hence the trylock.
+ */
+static int sc200pc_route_receiver(struct sc200pc *sensor, unsigned int streams)
+{
+	struct v4l2_subdev_route routes[SC200PC_STREAMS] = {
+		{ .sink_pad = 0, .sink_stream = 0, .source_pad = 1,
+		  .flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE },
+		{ .sink_pad = 0, .sink_stream = 1, .source_pad = 2,
+		  .flags = V4L2_SUBDEV_ROUTE_FL_ACTIVE },
+	};
+	struct v4l2_subdev_krouting routing = {
+		.len_routes = ARRAY_SIZE(routes),
+		.num_routes = streams,
+		.routes = routes,
+	};
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+		.pad = 0,
+		.format = sc200pc_format,
+	};
+	struct v4l2_subdev_state *state;
+	struct v4l2_subdev *csi;
+	struct media_pad *remote;
+	unsigned int i;
+	int ret;
+
+	remote = media_pad_remote_pad_first(&sensor->pad);
+	if (!remote)
+		return -ENOLINK;
+
+	csi = media_entity_to_v4l2_subdev(remote->entity);
+	if (!v4l2_subdev_has_op(csi, pad, set_routing) || !csi->active_state)
+		return -ENOTTY;
+
+	state = csi->active_state;
+	if (!mutex_trylock(state->lock))
+		return -EBUSY;
+
+	if (media_entity_is_streaming(remote->entity)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	ret = csi->ops->pad->set_routing(csi, state, V4L2_SUBDEV_FORMAT_ACTIVE,
+					 &routing);
+	for (i = 0; !ret && i < routing.num_routes; i++) {
+		fmt.stream = i;
+		ret = csi->ops->pad->set_fmt(csi, state, &fmt);
+	}
+
+unlock:
+	mutex_unlock(state->lock);
+	return ret;
+}
