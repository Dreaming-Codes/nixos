+	if (late) {
+		sensor->stretch = sensor->short_window - t.short_window;
+		mod_delayed_work(system_wq, &sensor->unstretch,
+				 nsecs_to_jiffies((u64)(t.vts + sensor->stretch) *
+						  SC200PC_ROW_NS) + 1);
+	}
