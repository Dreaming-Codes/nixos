From 68e1b29917ddaa35968289348bdc960b97a8caeb Mon Sep 17 00:00:00 2001
From: dreamingcodes <dreamingcodes@localhost>
Date: Tue, 20 Oct 2026 20:09:51 +0200
Subject: [PATCH] psys: match the in-tree intel_ipu7 ABI on kernels >= 6.17

From 6.17 only psys is built and it links against the in-tree staging
core. That core allocates struct ipu7_bus_device without
acquire_fw_task_buffer_lock and get_running_fw_task_count, so psys
wrote past the end of the 1008-byte object (intel/ipu7-drivers#93).

Limit the out-of-tree-only members of ipu7_bus_device, ipu7_device and
ipu7_mmu to the < 6.17 build so the private headers describe the
in-tree layout. Move the task-buffer lock into struct ipu7_psys and
drain running FW tasks in psys itself before each psys call that makes
the core invalidate the PSYS MMU TLB, since the in-tree core never
calls back into psys.
---
 drivers/media/pci/intel/ipu7/ipu7-bus.h       |  4 +
 drivers/media/pci/intel/ipu7/ipu7-mmu.h       |  5 ++
 drivers/media/pci/intel/ipu7/ipu7.h           |  3 +-
 drivers/media/pci/intel/ipu7/psys/ipu-psys.c  | 78 +++++++++++++++----
 drivers/media/pci/intel/ipu7/psys/ipu7-psys.h |  2 +
 5 files changed, 75 insertions(+), 17 deletions(-)

diff --git a/drivers/media/pci/intel/ipu7/ipu7-bus.h b/drivers/media/pci/intel/ipu7/ipu7-bus.h
index eb9d0c9..337d16e 100644
--- a/drivers/media/pci/intel/ipu7/ipu7-bus.h
+++ b/drivers/media/pci/intel/ipu7/ipu7-bus.h
@@ -13,6 +13,7 @@
 #include <linux/list.h>
 #include <linux/scatterlist.h>
 #include <linux/types.h>
+#include <linux/version.h>
 
 #include "abi/ipu7_fw_boot_abi.h"
 
@@ -47,11 +48,14 @@ struct ipu7_bus_device {
 	dma_addr_t boot_config_dma_addr;
 	u32 boot_config_size;
 
+	/* Only the out-of-tree core, built below 6.17, has these. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
 	/* Serialize FW message buffer or task queue acquisition against
 	 * TLB invalidation.
 	 */
 	struct mutex acquire_fw_task_buffer_lock;
 	unsigned int (*get_running_fw_task_count)(struct ipu7_bus_device *adev);
+#endif
 };
 
 struct ipu7_auxdrv_data {
diff --git a/drivers/media/pci/intel/ipu7/ipu7-mmu.h b/drivers/media/pci/intel/ipu7/ipu7-mmu.h
index e4bc485..4477745 100644
--- a/drivers/media/pci/intel/ipu7/ipu7-mmu.h
+++ b/drivers/media/pci/intel/ipu7/ipu7-mmu.h
@@ -10,6 +10,7 @@
 #include <linux/list.h>
 #include <linux/spinlock_types.h>
 #include <linux/types.h>
+#include <linux/version.h>
 
 struct device;
 struct page;
@@ -402,7 +403,11 @@ struct ipu7_mmu {
 	bool ready;
 	spinlock_t ready_lock;	/* Serialize access to bool ready */
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
 	void (*tlb_invalidate)(struct ipu7_mmu *mmu, int mmu_id);
+#else
+	void (*tlb_invalidate)(struct ipu7_mmu *mmu);
+#endif
 };
 
 struct ipu7_mmu *ipu7_mmu_init(struct device *dev,
diff --git a/drivers/media/pci/intel/ipu7/ipu7.h b/drivers/media/pci/intel/ipu7/ipu7.h
index b48bc1d..f5776f5 100644
--- a/drivers/media/pci/intel/ipu7/ipu7.h
+++ b/drivers/media/pci/intel/ipu7/ipu7.h
@@ -9,6 +9,7 @@
 #include <linux/list.h>
 #include <linux/pci.h>
 #include <linux/types.h>
+#include <linux/version.h>
 
 #include "ipu7-buttress.h"
 
@@ -85,7 +86,7 @@ struct ipu7_device {
 	bool ipc_reinit;
 	bool secure_mode;
 	bool ipu7_bus_ready_to_probe;
-#ifdef CONFIG_DEBUG_FS
+#if defined(CONFIG_DEBUG_FS) && LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
 	struct dentry *ipu7_dir;
 #endif
 };
diff --git a/drivers/media/pci/intel/ipu7/psys/ipu-psys.c b/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
index ce16e4c..3d8b429 100644
--- a/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
+++ b/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
@@ -43,10 +43,56 @@ static int psys_runtime_pm_suspend(struct device *dev);
 #define IPU_FW_CALL_TIMEOUT_JIFFIES			\
 	msecs_to_jiffies(IPU_PSYS_CMD_TIMEOUT_MS)
 
+#define WAIT_FW_TASKS_CLEAR_TIME_MS	17
+#define WAIT_FW_TASKS_CLEAR_TIMES	5
+
 static dev_t ipu7_psys_dev_t;
 static DECLARE_BITMAP(ipu7_psys_devices, IPU_PSYS_NUM_DEVICES);
 static DEFINE_MUTEX(ipu7_psys_mutex);
 
+static unsigned int
+ipu7_psys_get_running_fw_task_count(struct ipu7_psys *psys);
+
+/*
+ * Wait for running FW tasks to finish before the core invalidates the PSYS
+ * MMU TLB. Hold fw_task_buffer_lock so no new task starts meanwhile.
+ */
+static void ipu7_psys_wait_fw_tasks_clear(struct ipu7_psys *psys)
+{
+	unsigned int prev_task_cnt = UINT_MAX;
+	unsigned int not_decreasing_count = 0;
+	unsigned int curr_task_cnt;
+
+	lockdep_assert_held(&psys->fw_task_buffer_lock);
+
+	while ((curr_task_cnt = ipu7_psys_get_running_fw_task_count(psys))) {
+		if (curr_task_cnt >= prev_task_cnt)
+			not_decreasing_count++;
+		else
+			not_decreasing_count = 0;
+		prev_task_cnt = curr_task_cnt;
+
+		if (not_decreasing_count > WAIT_FW_TASKS_CLEAR_TIMES) {
+			dev_warn(&psys->dev,
+				 "wait running fw tasks clear timeout\n");
+			return;
+		}
+
+		msleep(WAIT_FW_TASKS_CLEAR_TIME_MS);
+	}
+}
+
+static void ipu7_psys_dma_unmap_sgtable(struct ipu7_psys *psys,
+					struct sg_table *sgt,
+					enum dma_data_direction dir,
+					unsigned long attrs)
+{
+	mutex_lock(&psys->fw_task_buffer_lock);
+	ipu7_psys_wait_fw_tasks_clear(psys);
+	ipu7_dma_unmap_sgtable(psys->adev, sgt, dir, attrs);
+	mutex_unlock(&psys->fw_task_buffer_lock);
+}
+
 static int ipu7_psys_get_userpages(struct ipu7_dma_buf_attach *attach)
 {
 	struct vm_area_struct *vma;
@@ -206,7 +252,8 @@ static void ipu7_dma_buf_unmap(struct dma_buf_attachment *attach,
 	struct ipu7_device *isp = pci_get_drvdata(pdev);
 	struct ipu7_bus_device *adev = isp->psys;
 
-	ipu7_dma_unmap_sgtable(adev, sgt, dir, DMA_ATTR_SKIP_CPU_SYNC);
+	ipu7_psys_dma_unmap_sgtable(ipu7_bus_get_drvdata(adev), sgt, dir,
+				    DMA_ATTR_SKIP_CPU_SYNC);
 	dma_unmap_sgtable(&pdev->dev, sgt, DMA_BIDIRECTIONAL, 0);
 }
 
@@ -503,8 +550,8 @@ static inline void ipu7_psys_kbuf_unmap(struct ipu7_psys_fh *fh,
 	}
 
 	if (!kbuf->userptr)
-		ipu7_dma_unmap_sgtable(fh->psys->adev, kbuf->sgt,
-				       DMA_BIDIRECTIONAL, 0);
+		ipu7_psys_dma_unmap_sgtable(fh->psys, kbuf->sgt,
+					    DMA_BIDIRECTIONAL, 0);
 
 	if (kbuf->sgt)
 		dma_buf_unmap_attachment_unlocked(kbuf->db_attach,
@@ -545,7 +592,10 @@ static int ipu7_psys_release(struct inode *inode, struct file *file)
 	}
 	mutex_unlock(&fh->mutex);
 
+	mutex_lock(&psys->fw_task_buffer_lock);
+	ipu7_psys_wait_fw_tasks_clear(psys);
 	ipu7_psys_stream_deinit(fh->ip, psys->adev);
+	mutex_unlock(&psys->fw_task_buffer_lock);
 
 	mutex_lock(&psys->mutex);
 	list_del(&fh->list);
@@ -775,8 +825,8 @@ mapbuf_end:
 kbuf_map_fail:
 	if (!IS_ERR_OR_NULL(kbuf->sgt)) {
 		if (!kbuf->userptr)
-			ipu7_dma_unmap_sgtable(psys->adev, kbuf->sgt,
-					       DMA_BIDIRECTIONAL, 0);
+			ipu7_psys_dma_unmap_sgtable(psys, kbuf->sgt,
+						    DMA_BIDIRECTIONAL, 0);
 		dma_buf_unmap_attachment_unlocked(kbuf->db_attach,
 						  kbuf->sgt,
 						  DMA_BIDIRECTIONAL);
@@ -1005,16 +1055,12 @@ unlock:
 	return NULL;
 }
 
-static unsigned int ipu7_psys_get_running_fw_task_count(
-					      struct ipu7_bus_device *adev)
+static unsigned int
+ipu7_psys_get_running_fw_task_count(struct ipu7_psys *psys)
 {
-	struct ipu7_psys *psys = ipu7_bus_get_drvdata(adev);
 	struct ipu7_psys_fh *fh;
 	unsigned int count = 0;
 
-	if (!psys)
-		return 0;
-
 	mutex_lock(&psys->mutex);
 	list_for_each_entry(fh, &psys->fhs, list) {
 		mutex_lock(&fh->ip->task_mutex);
@@ -1038,9 +1084,9 @@ static long ipu_psys_task_request(struct ipu_psys_task_request *task,
 		return -EINVAL;
 	}
 
-	mutex_lock(&psys->adev->acquire_fw_task_buffer_lock);
+	mutex_lock(&psys->fw_task_buffer_lock);
 	tq = ipu7_psys_get_task_queue(fh->ip, task);
-	mutex_unlock(&psys->adev->acquire_fw_task_buffer_lock);
+	mutex_unlock(&psys->fw_task_buffer_lock);
 	if (!tq) {
 		dev_err(&psys->dev, "Failed to get task queue\n");
 		return -EINVAL;
@@ -1446,6 +1492,7 @@ static int ipu7_psys_probe(struct auxiliary_device *auxdev,
 	psys->timeout = IPU_PSYS_CMD_TIMEOUT_MS;
 
 	mutex_init(&psys->mutex);
+	mutex_init(&psys->fw_task_buffer_lock);
 	INIT_LIST_HEAD(&psys->fhs);
 
 	ret = ipu7_fw_psys_init(psys);
@@ -1466,8 +1513,6 @@ static int ipu7_psys_probe(struct auxiliary_device *auxdev,
 	}
 
 	dev_set_drvdata(dev, psys);
-	adev->get_running_fw_task_count =
-		ipu7_psys_get_running_fw_task_count;
 	mutex_unlock(&ipu7_psys_mutex);
 #ifdef CONFIG_DEBUG_FS
 	psys_fw_log_init(psys);
@@ -1483,6 +1528,7 @@ static int ipu7_psys_probe(struct auxiliary_device *auxdev,
 out_fw_release:
 	ipu7_fw_psys_release(psys);
 out_mutex_destroy:
+	mutex_destroy(&psys->fw_task_buffer_lock);
 	mutex_destroy(&psys->mutex);
 	cdev_del(&psys->cdev);
 out_unlock:
@@ -1503,7 +1549,6 @@ static void ipu7_psys_remove(struct auxiliary_device *auxdev)
 	struct ipu7_psys *psys = dev_get_drvdata(&auxdev->dev);
 	struct device *dev = &auxdev->dev;
 
-	psys->adev->get_running_fw_task_count = NULL;
 #ifdef CONFIG_DEBUG_FS
 	if (psys->debugfsdir)
 		debugfs_remove_recursive(psys->debugfsdir);
@@ -1516,6 +1561,7 @@ static void ipu7_psys_remove(struct auxiliary_device *auxdev)
 	cdev_del(&psys->cdev);
 	mutex_unlock(&ipu7_psys_mutex);
 
+	mutex_destroy(&psys->fw_task_buffer_lock);
 	mutex_destroy(&psys->mutex);
 
 	unregister_chrdev_region(ipu7_psys_dev_t, IPU_PSYS_NUM_DEVICES);
diff --git a/drivers/media/pci/intel/ipu7/psys/ipu7-psys.h b/drivers/media/pci/intel/ipu7/psys/ipu7-psys.h
index a72ce4a..e969c40 100644
--- a/drivers/media/pci/intel/ipu7/psys/ipu7-psys.h
+++ b/drivers/media/pci/intel/ipu7/psys/ipu7-psys.h
@@ -113,6 +113,8 @@ struct ipu7_psys {
 	struct device dev;
 
 	struct mutex mutex;	/* Psys various */
+	/* Serialize task queue acquisition against TLB invalidation */
+	struct mutex fw_task_buffer_lock;
 	int ready; /* psys fw status */
 	spinlock_t ready_lock;	/* protect psys firmware state */
 
-- 
2.55.0

