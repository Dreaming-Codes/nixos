+#define NNTM_PARAMS_META "GstNntmParamsMeta"
+
+static void
+gst_camerasrc_attach_nntm_params(Gstcamerasrc *camerasrc, GstBuffer *gbuffer, int64_t sequence)
+{
+  GstCustomMeta *old = gst_buffer_get_custom_meta(gbuffer, NNTM_PARAMS_META);
+  if (old)
+    gst_buffer_remove_meta(gbuffer, (GstMeta *)old);
+
+  int size = camera_get_nntm_params(camerasrc->device_id, sequence, NULL, 0);
+  if (size <= 0)
+    return;
+  gpointer data = g_malloc(size);
+  if (camera_get_nntm_params(camerasrc->device_id, sequence, data, size) != size) {
+    g_free(data);
+    return;
+  }
+  GBytes *record = g_bytes_new_take(data, size);
+  GstCustomMeta *meta = gst_buffer_add_custom_meta(gbuffer, NNTM_PARAMS_META);
+  gst_structure_set(gst_custom_meta_get_structure(meta), "record", G_TYPE_BYTES, record, NULL);
+  g_bytes_unref(record);
+}
