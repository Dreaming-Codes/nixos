+/* PAM_AUTHTOK from an earlier module, used once. CTAP2 PINs are 4-63 bytes. */
+static char *authtok_pin(const cfg_t *cfg, pam_handle_t *pamh, int *tried) {
+  const void *item = NULL;
+  size_t len;
+
+  if (!cfg->authtok_pin || *tried)
+    return NULL;
+  *tried = 1;
+  if (pam_get_item(pamh, PAM_AUTHTOK, &item) != PAM_SUCCESS || item == NULL)
+    return NULL;
+  len = strlen(item);
+  if (len < 4 || len > 63)
+    return NULL;
+  return strdup(item);
+}
